#!/usr/bin/env bash
# Met à jour Orbe OS : clés des paquets d'abord (un PC resté éteint des mois échoue sinon),
# instantané btrfs « important » (snapper, si / est en btrfs), puis pacman -Syu. snap-pac prend
# aussi un instantané avant et après la transaction. Signale ensuite les fichiers .pacnew et
# un redémarrage utile (noyau, pilote NVIDIA, Mesa).
set -u
printf '\033[1;38;2;211;253;80mMise à jour d’Orbe OS\033[0m\n\n'
sudo pacman -Sy --needed --noconfirm archlinux-keyring || true
if command -v snapper >/dev/null && sudo snapper list-configs 2>/dev/null | grep -q '^root '; then
  sudo snapper -c root create -t single -c number --userdata important=yes \
    -d "Avant la mise à jour du $(date '+%d/%m/%Y à %H:%M')" && echo "Instantané du système créé."
fi
before=$(pacman -Q linux linux-lts linux-zen nvidia-utils mesa 2>/dev/null)
sudo pacman -Su
status=$?
after=$(pacman -Q linux linux-lts linux-zen nvidia-utils mesa 2>/dev/null)
echo
if [[ $status -eq 0 ]]; then
  echo "Terminé."
  [[ $before != "$after" ]] && echo "Le noyau ou les pilotes graphiques ont changé : redémarre pour en profiter."
  pacnew=$(find /etc -name '*.pacnew' 2>/dev/null)
  [[ -n $pacnew ]] && printf 'Nouvelles versions de fichiers de configuration à comparer (pacdiff) :\n%s\n' "$pacnew"
else
  echo "La mise à jour n'a pas abouti (code $status)."
fi
read -rp "Entrée pour fermer " _
exit "$status"
