#!/usr/bin/env bash
# Met à jour Orbe OS : instantané btrfs « important » avant (snapper, si / est en btrfs),
# puis pacman -Syu. snap-pac prend aussi un instantané avant et après la transaction.
set -u
printf '\033[1;38;2;211;253;80mMise à jour d’Orbe OS\033[0m\n\n'
if command -v snapper >/dev/null && sudo snapper list-configs 2>/dev/null | grep -q '^root '; then
  sudo snapper -c root create -t single -c number --userdata important=yes \
    -d "Avant la mise à jour du $(date '+%d/%m/%Y à %H:%M')" && echo "Instantané du système créé."
fi
sudo pacman -Syu
status=$?
echo
[[ $status -eq 0 ]] && echo "Terminé. Redémarre si le noyau ou les pilotes ont été mis à jour." || echo "La mise à jour n'a pas abouti (code $status)."
read -rp "Entrée pour fermer " _
exit "$status"
