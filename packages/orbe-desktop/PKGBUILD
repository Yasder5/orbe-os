# Maintainer: yasder5
# Bureau Orbe OS : dépendances de la session et configuration Hyprland par défaut.
# Version fournie par build.sh (ORBE_VERSION), dérivée de l'historique git.

pkgname=orbe-desktop
pkgver=${ORBE_VERSION:-0.1.0}
pkgrel=1
pkgdesc="Bureau Orbe OS : session Hyprland et Orbe Shell, réglages par défaut"
arch=('any')
options=('!debug')
url="https://github.com/Yasder5/orbe-os"
license=('MIT')
depends=(
  'orbe-shell' 'orbe-themes' 'orbe-wallpapers'
  'hyprland' 'quickshell' 'hyprpolkitagent' 'hyprland-guiutils'
  'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk'
  'qt6-wayland' 'qt5-wayland' 'qt6-svg' 'qt6-5compat'
  'pipewire' 'pipewire-pulse' 'pipewire-alsa' 'wireplumber'
  'foot' 'wl-clipboard' 'grim' 'slurp' 'brightnessctl' 'playerctl' 'xdg-utils' 'polkit' 'libnotify'
  'noto-fonts' 'noto-fonts-emoji' 'ttf-jetbrains-mono' 'ttf-nerd-fonts-symbols-mono'
  # Terminal : shell fish, invite Starship, fastfetch, ls, cat et moniteur en couleurs
  'fish' 'starship' 'fastfetch' 'eza' 'bat' 'btop'
  # Réglages rapides, verrouillage, mode nuit, visualiseur audio
  'networkmanager' 'bluez' 'bluez-utils' 'power-profiles-daemon' 'hypridle' 'hyprsunset' 'cava'
  # Fermeture propre des applications avant de quitter Hyprland (déconnexion, mode jeu)
  'hyprshutdown'
  # Thème global : fichiers (GTK 4), GTK 3, Qt, icônes, démarrage, identité, réglages dconf
  'nautilus' 'adw-gtk-theme' 'qt6ct' 'orbe-icon-theme' 'orbe-branding' 'plymouth' 'dconf'
  # Écran de connexion Orbe (greetd, cage, Quickshell)
  'greetd' 'cage'
  # Réglages Orbe : liste des mises à jour (checkupdates), réseau avancé ; presse-papiers
  'pacman-contrib' 'cliphist'
  # Captures annotées, enregistrement vidéo par la carte graphique, jeux dans le lanceur
  'satty' 'gpu-screen-recorder' 'python'
)
install=orbe-desktop.install
# Modules Hyprland (orbe.lua charge les autres) et fichiers personnels copiés dans /etc/skel.
source=(orbe.lua environment.lua look.lua input.lua binds.lua workspaces.lua rules.lua autostart.lua
        hyprland.lua foot.ini btop.conf heroic-store.json orbe-first-login orbe-idle hypridle.conf hyprtoolkit.conf orbe-greeter
        orbe-update orbe-autologin orbe-add-user orbe-reglages.desktop
        orbe-check-session orbe-diagnostic orbe-suspend-check orbe-windows orbe-windows-scan.service
        org.orbe.windows.policy orbe-record orbe-steam-fond orbe-capture orbe-games)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  local f
  for f in orbe environment look input binds workspaces rules autostart; do
    install -Dm644 "$srcdir/$f.lua" "$pkgdir/usr/share/orbe/hypr/$f.lua"
  done
  # Fichier personnel copié dans le dossier des nouveaux comptes.
  install -Dm644 "$srcdir/hyprland.lua" "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
  install -Dm644 "$srcdir/foot.ini" "$pkgdir/etc/skel/.config/foot/foot.ini"
  install -Dm644 "$srcdir/btop.conf" "$pkgdir/etc/skel/.config/btop/btop.conf"
  # GTK 3 et 4 : thème adw-gtk3-dark, couleurs Orbe incluses depuis /usr/share/orbe/gtk.
  local v
  for v in 3 4; do
    printf '/* Couleurs Orbe (paquet orbe-themes). Vos retouches vont sous cette ligne. */\n@import url("file:///usr/share/orbe/gtk/gtk%s.css");\n' "$v" \
      | install -Dm644 /dev/stdin "$pkgdir/etc/skel/.config/gtk-$v.0/gtk.css"
  done
  install -Dm644 "$ORBE_SRC/themes/gtk/settings.ini" "$pkgdir/etc/skel/.config/gtk-3.0/settings.ini"
  install -Dm644 "$ORBE_SRC/themes/gtk/gtk4-settings.ini" "$pkgdir/etc/skel/.config/gtk-4.0/settings.ini"
  # Qt : qt6ct avec la palette Orbe.
  install -Dm644 "$ORBE_SRC/themes/qt/qt6ct.conf" "$pkgdir/etc/skel/.config/qt6ct/qt6ct.conf"
  # Curseur par défaut des applications X11 qui ignorent XCURSOR_THEME.
  printf '[Icon Theme]\nInherits=Orbe\n' | install -Dm644 /dev/stdin "$pkgdir/etc/skel/.icons/default/index.theme"
  # Réglages par défaut des applications GNOME (thème sombre, icônes, polices, sons).
  install -Dm644 "$ORBE_SRC/themes/gtk/dconf-profile-user" "$pkgdir/etc/dconf/profile/user"
  install -Dm644 "$ORBE_SRC/themes/gtk/dconf-orbe" "$pkgdir/etc/dconf/db/local.d/00-orbe"

  # Couleurs d'Orbe pour les fenêtres hyprtoolkit (hyprshutdown, dialogues de Hyprland).
  install -Dm644 "$srcdir/hyprtoolkit.conf" "$pkgdir/etc/skel/.config/hypr/hyprtoolkit.conf"
  # Heroic (jeux Epic et GOG) : thème Orbe choisi d'office ; le reste est écrit au premier
  # lancement par orbe-first-login, avec les chemins absolus du compte.
  install -Dm644 "$srcdir/heroic-store.json" "$pkgdir/etc/skel/.config/heroic/store/config.json"
  install -Dm755 "$srcdir/orbe-first-login" "$pkgdir/usr/bin/orbe-first-login"
  install -Dm755 "$srcdir/orbe-idle" "$pkgdir/usr/bin/orbe-idle"
  install -Dm755 "$srcdir/orbe-greeter" "$pkgdir/usr/bin/orbe-greeter"
  local tool
  for tool in orbe-update orbe-autologin orbe-add-user orbe-check-session orbe-diagnostic \
              orbe-suspend-check orbe-windows orbe-record orbe-steam-fond orbe-capture orbe-games; do
    install -Dm755 "$srcdir/$tool" "$pkgdir/usr/bin/$tool"
  done
  install -Dm644 "$srcdir/orbe-reglages.desktop" "$pkgdir/usr/share/applications/orbe-reglages.desktop"
  # Redémarrer sous Windows : entrée trouvée à chaque démarrage, grub-reboot sans mot de passe.
  install -Dm644 "$srcdir/orbe-windows-scan.service" "$pkgdir/usr/lib/systemd/system/orbe-windows-scan.service"
  install -Dm644 "$srcdir/org.orbe.windows.policy" "$pkgdir/usr/share/polkit-1/actions/org.orbe.windows.policy"
  install -Dm644 "$srcdir/hypridle.conf" "$pkgdir/usr/share/orbe/hypr/hypridle.conf"

  # Entrées masquées du lanceur : outils en ligne de commande et doublons. Ce dossier passe
  # avant /usr/share dans XDG_DATA_DIRS (environment.lua), donc ces fichiers l'emportent.
  local id
  for id in foot-server footclient org.quickshell lftp vim stoken-gui stoken-gui-small htop \
            bvnc bssh avahi-discover qv4l2 qvidcap; do
    printf '[Desktop Entry]\nType=Application\nName=%s\nNoDisplay=true\n' "$id" \
      | install -Dm644 /dev/stdin "$pkgdir/usr/share/orbe/applications/$id.desktop"
  done
}
