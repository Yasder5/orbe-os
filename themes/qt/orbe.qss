/* Retouches Orbe pour le style Fusion de Qt : angles de 4 à 8 px, focus citron. */
QPushButton, QToolButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
  border-radius: 6px;
}
QPushButton {
  background: #1a1a19; color: #f5f5f0; border: 1px solid #262624; padding: 6px 14px;
}
QPushButton:hover { background: #262624; }
QPushButton:default, QPushButton:checked { background: #d3fd50; color: #0a0a0a; border-color: #d3fd50; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #d3fd50; }
QLineEdit, QSpinBox, QComboBox { background: #0d0d0c; border: 1px solid #262624; padding: 4px 8px; }
QMenu { background: #121212; border: 1px solid #262624; border-radius: 8px; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 4px; }
QMenu::item:selected { background: #d3fd50; color: #0a0a0a; }
QToolTip { background: #1a1a19; color: #f5f5f0; border: 1px solid #262624; border-radius: 4px; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #3a3a37; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
