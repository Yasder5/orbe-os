# Thème btop d'Orbe OS (/usr/share/btop/themes/orbe.theme) : noir profond, accent citron.

theme[main_bg]="#0a0a0a"
theme[main_fg]="#f5f5f0"
theme[title]="#f5f5f0"
theme[hi_fg]="#d3fd50"
theme[selected_bg]="#262624"
theme[selected_fg]="#d3fd50"
theme[inactive_fg]="#3a3a37"
