// fastfetch d'Orbe OS : orbe de particules en ASCII et informations système en français.
// Remplacé par ~/.config/fastfetch/config.jsonc s'il existe.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/orbe/fastfetch/orbe-logo.txt",
    "color": {
      "1": "38;2;143;143;138",
      "2": "38;2;211;253;80"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;211;253;80",
      "title": "38;2;245;245;240",
      "output": "38;2;245;245;240",
      "separator": "38;2;58;58;55"
    },
    "key": {
      "width": 18
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "■"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "color": {
        "elapsed": "38;2;211;253;80",
        "total": "38;2;58;58;55"
      },
      "width": 12
    },
    "percent": {
      "type": ["num", "bar"],
      "color": {
        "green": "38;2;211;253;80",
        "yellow": "38;2;245;215;110",
        "red": "38;2;255;107;90"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;2;58;58;55"
    },
    { "type": "os", "key": "Système" },
    { "type": "kernel", "key": "Noyau" },
    { "type": "uptime", "key": "Allumé depuis" },
    { "type": "packages", "key": "Paquets" },
    { "type": "shell", "key": "Shell" },
    { "type": "wm", "key": "Bureau" },
    { "type": "terminal", "key": "Terminal" },
    "break",
    { "type": "cpu", "key": "Processeur" },
    { "type": "gpu", "key": "Carte graphique" },
    { "type": "memory", "key": "Mémoire" },
    { "type": "disk", "key": "Disque", "folders": "/" },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0
    }
  ]
}
